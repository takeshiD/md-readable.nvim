# 全テープ共通の表示設定（各テープから Source で読み込む）
Set Shell "bash"
Set FontFamily "Ioskeley Mono JP NF, JetBrainsMono Nerd Font, DejaVu Sans Mono, monospace"
Set FontSize 16
Set Width 1440
Set Height 810
Set Padding 18
Set Margin 24
Set MarginFill "#414868"
Set BorderRadius 10
Set WindowBar Colorful
Set Theme "TokyoNight"
Set TypingSpeed 55ms
Set CursorBlink false
