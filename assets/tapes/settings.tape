# 全テープ共通の表示設定（各テープから Source で読み込む）
Set Shell "zsh"
Set FontFamily "Ioskeley Mono JP NF, JetBrainsMono Nerd Font, DejaVu Sans Mono, monospace"
Set FontSize 32
Set Width 1440
Set Height 1080
Set Padding 18
Set Margin 24
Set MarginFill "#181818"
Set BorderRadius 10
# Set WindowBar Colorful
Set Theme "ayu"
Set TypingSpeed 100ms
Set CursorBlink false
